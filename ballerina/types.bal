public type BillingInfo record {
    Address address?;
    # Customer's VAT number (to avoid having the VAT applied). This is only used for automatically collected invoices
    @jsondata:Name {value: "vat_number"}
    string vatNumber?;
    @jsondata:Name {value: "last_name"}
    string lastName?;
    # When the billing information was created
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # The `primary_payment_method` field is used to indicate the primary billing info on the account. The first billing info created on an account will always become primary. This payment method will be used
    @jsondata:Name {value: "primary_payment_method"}
    boolean primaryPaymentMethod?;
    boolean valid?;
    @jsondata:Name {value: "account_id"}
    string accountId?;
    # When the billing information was last changed
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # Most recent fraud result
    FraudInformation fraud?;
    # The `backup_payment_method` field is used to indicate a billing info as a backup on the account that will be tried if the initial billing info used for an invoice is declined
    @jsondata:Name {value: "backup_payment_method"}
    boolean backupPaymentMethod?;
    @jsondata:Name {value: "updated_by"}
    BillingInfoUpdatedBy updatedBy?;
    @constraint:String {maxLength: 100}
    string company?;
    @constraint:String {maxLength: 13}
    string id?;
    # Array of Payment Gateway References, each a reference to a third-party gateway object of varying types
    @jsondata:Name {value: "payment_gateway_references"}
    PaymentGatewayReferences[] paymentGatewayReferences?;
    @jsondata:Name {value: "first_name"}
    string firstName?;
    @jsondata:Name {value: "payment_method"}
    PaymentMethod paymentMethod?;
    string 'object?;
};

