    string gatewayCode?;
    # A token generated by Recurly.js after completing a 3-D Secure device fingerprinting or authentication challenge
    @jsondata:Name {value: "three_d_secure_action_result_token_id"}
    string threeDSecureActionResultTokenId?;
};

public type ExternalInvoiceCreate record {
    string total;
    # When the invoice was created in the external platform
    @jsondata:Name {value: "purchased_at"}
    string purchasedAt;
    @jsondata:Name {value: "external_payment_phase"}
    ExternalPaymentPhaseBase externalPaymentPhase?;
    # An identifier which associates the external invoice to a corresponding object in an external platform
    @jsondata:Name {value: "external_id"}
    string externalId;
    # 3-letter ISO 4217 currency code
    @constraint:String {maxLength: 3}
    string currency;
    ExternalInvoiceStateEnum state;
    @jsondata:Name {value: "line_items"}
    ExternalChargeCreate[] lineItems?;
    # External payment phase ID, e.g. `a34ypb2ef9w1`
    @jsondata:Name {value: "external_payment_phase_id"}
    string externalPaymentPhaseId?;
};

public type ExternalProductReferenceCollection record {
    # Path to subsequent page of results
    string next?;
    ExternalProductReferenceMini[] data?;
    # Indicates there are more results on subsequent pages
    @jsondata:Name {value: "has_more"}
    boolean hasMore?;
