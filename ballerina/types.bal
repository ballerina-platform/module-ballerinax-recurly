    @constraint:String {maxLength: 255}
    string email?;
    string 'object?;
};

# The origin type of a credit invoice that can be allowed in a credit application policy
public type CreditApplicationAllowedOriginTypeEnum "line_item_refund"|"open_amount_refund"|"immediate_change"|"termination"|"credit"|"write_off"|"refund"|"external_refund"|"carryforward_credit"|"usage_correction"|"prepayment"|"gift_card"|"carryforward_gift_credit";

public type Invoice record {
    @jsondata:Name {value: "reference_only_currency_conversion"}
    ReferenceOnlyCurrencyConversion referenceOnlyCurrencyConversion?;
    # VAT registration number for the customer on this invoice. This will come from the VAT Number field in the Billing Info or the Account Info depending on your tax settings and the invoice collection method
    @jsondata:Name {value: "vat_number"}
    string vatNumber?;
    OriginEnum origin?;
    # Total discounts applied to this invoice
    float discount?;
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    @jsondata:Name {value: "net_terms_type"}
    NetTermsTypeEnum netTermsType?;
    @jsondata:Name {value: "line_items"}
    LineItem[] lineItems?;
    InvoiceTypeEnum 'type?;
    string uuid?;
    # VAT Reverse Charge Notes only appear if you have EU VAT enabled or are using your own Avalara AvaTax account and the customer is in the EU, has a VAT number, and is in a different country than your own. This will default to the VAT Reverse Charge Notes text specified on the Tax Settings page in your Recurly admin, unless custom notes were created with the original subscription
    @jsondata:Name {value: "vat_reverse_charge_notes"}
    string vatReverseChargeNotes?;
    # If the invoice is charging or refunding for one or more subscriptions, these are their IDs
    @jsondata:Name {value: "subscription_ids"}
    InvoiceSubscriptionidsItemsString[] subscriptionIds?;
    # If VAT taxation and the Country Invoice Sequencing feature are enabled, invoices will have country-specific invoice numbers for invoices billed to EU countries (ex: FR1001). Non-EU invoices will continue to use the site-level invoice number sequence
    string number?;
    # For manual invoicing, this identifies the PO number associated with the subscription
    @jsondata:Name {value: "po_number"}
    string poNumber?;
    # The final total on this invoice. The summation of invoice charges, discounts, credits, and tax
    float total?;
    # The outstanding balance remaining on this invoice
    float balance?;
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # Unique ID to identify the dunning campaign used when dunning the invoice. For sites without multiple dunning campaigns enabled, this will always be the default dunning campaign
    @jsondata:Name {value: "dunning_campaign_id"}
    string dunningCampaignId?;
    # On refund invoices, this value will exist and show the invoice ID of the purchase invoice the refund was created from. This field is only populated for sites without the [Only Bill What Changed](https://docs.recurly.com/docs/only-bill-what-changed) feature enabled. Sites with Only Bill What Changed enabled should use the [related_invoices endpoint](https://recurly.com/developers/api/v2021-02-25/index.html#operation/list_related_invoices) to see purchase invoices refunded by this invoice
    @jsondata:Name {value: "previous_invoice_id"}
    string previousInvoiceId?;
    # Integer paired with `Net Terms Type` and representing the number
    # of days past the current date (for `net` Net Terms Type) or days after
    # the last day of the current month (for `eom` Net Terms Type) that the
    # invoice will become past due. For `manual` collection method, an additional 24 hours is
    # added to ensure the customer has the entire last day to make payment before
    # becoming past due. For example:
    # 
    # If an invoice is due `net 0`, it is due 'On Receipt' and will become past due 24 hours after it's created.
    # If an invoice is due `net 30`, it will become past due at 31 days exactly.
    # If an invoice is due `eom 30`, it will become past due 31 days from the last day of the current month.
    # 
    # For `automatic` collection method, the additional 24 hours is not added. For example, On-Receipt is due immediately, and `net 30` will become due exactly 30 days from invoice generation, at which point Recurly will attempt collection.
    # When `eom` Net Terms Type is passed, the value for `Net Terms` is restricted to `0, 15, 30, 45, 60, or 90`.
    # 
    # For more information on how net terms work with `manual` collection visit our docs page (https://docs.recurly.com/docs/manual-payments#section-collection-terms)
    # or visit (https://docs.recurly.com/docs/automatic-invoicing-terms#section-collection-terms) for information about net terms using `automatic` collection
    @jsondata:Name {value: "net_terms"}
    int netTerms = 0;
    # 3-letter ISO 4217 currency code
    @constraint:String {maxLength: 3}
    string currency?;
    # Date invoice is due. This is the date the net terms are reached
    @jsondata:Name {value: "due_at"}
    string dueAt?;
    # Number of times the event was sent
    @jsondata:Name {value: "dunning_events_sent"}
    int dunningEventsSent?;
    string id?;
    InvoiceStateEnum state?;
    @jsondata:Name {value: "shipping_address"}
    ShippingAddress shippingAddress?;
    # Unique ID to identify the business entity assigned to the invoice. Available when the `Multiple Business Entities` feature is enabled
    @jsondata:Name {value: "business_entity_id"}
    string businessEntityId?;
    # The `billing_info_id` is the value that represents a specific billing info for an end customer. When `billing_info_id` is used to assign billing info to the subscription, all future billing events for the subscription will bill to the specified billing info. `billing_info_id` can ONLY be used for sites utilizing the Wallet feature
    @jsondata:Name {value: "billing_info_id"}
    string billingInfoId?;
    # Last communication attempt
    @jsondata:Name {value: "final_dunning_event"}
    boolean finalDunningEvent?;
    InvoiceAddress address?;
    # Date invoice was marked paid or failed
    @jsondata:Name {value: "closed_at"}
    string closedAt?;
    @jsondata:Name {value: "credit_payments"}
    CreditPayment[] creditPayments?;
    @jsondata:Name {value: "custom_fields"}
    InvoiceCustomFields customFields?;
    # The total tax on this invoice
    float tax?;
    # Identifies if the invoice has more line items than are returned in `line_items`. If `has_more_line_items` is `true`, then a request needs to be made to the `list_invoice_line_items` endpoint
    @jsondata:Name {value: "has_more_line_items"}
    boolean hasMoreLineItems?;
    # This will default to the Customer Notes text specified on the Invoice Settings. Specify custom notes to add or override Customer Notes
    @jsondata:Name {value: "customer_notes"}
    string customerNotes?;
    Transaction[] transactions?;
    # Will be `true` when the invoice had a successful response from the tax service and `false` when the invoice was not sent to tax service due to a lack of address or enabled jurisdiction or was processed without tax due to a non-blocking error returned from the tax service
    @jsondata:Name {value: "used_tax_service"}
    boolean usedTaxService?;
    # The summation of charges and credits, after discounts applied
    @jsondata:Name {value: "subtotal_after_discount"}
    float subtotalAfterDiscount?;
    # This will default to the Terms and Conditions text specified on the Invoice Settings page in your Recurly admin. Specify custom notes to add or override Terms and Conditions
    @jsondata:Name {value: "terms_and_conditions"}
    string termsAndConditions?;
    # The coupon redemptions applied to this invoice
    @jsondata:Name {value: "coupon_redemptions"}
    CouponRedemptionMini[] couponRedemptions?;
    # The refundable amount on a charge invoice. It will be null for all other invoices
    @jsondata:Name {value: "refundable_amount"}
    float refundableAmount?;
    @jsondata:Name {value: "tax_info"}
    TaxInfo taxInfo?;
    # The summation of charges and credits, before discounts and taxes
    float subtotal?;
    @jsondata:Name {value: "collection_method"}
    CollectionMethodEnum collectionMethod?;
    # The total amount of successful payments transaction on this invoice
    float paid?;
    AccountMini account?;
    string 'object?;
};

public type PlanUpdate record {
    # Unique code to identify the plan. This is used in Hosted Payment Page URLs and in the invoice exports
    PlanCode code?;
    @jsondata:Name {value: "setup_fees"}
    PlanSetupPricingCreate[] setupFees?;
    # This name describes your plan and will appear on the Hosted Payment Page and the subscriber's invoice
    PlanName name?;
    @jsondata:Name {value: "ramp_intervals"}
    PlanRampInterval[] rampIntervals?;
    # This field has no effect on the request/response
    # 
    # # Deprecated
    @deprecated
    string id?;
    # Required only when `pricing_model` is `'fixed'`
    PlanPricing[] currencies?;
    *PlanCommon;
};

public type AlphanumericSortEnum "asc"|"desc";

# Type of usage, required if `add_on_type` is `usage`. See our
# [Guide](https://recurly.com/developers/guides/usage-based-billing-guide.html) for an
# overview of how to configure usage add-ons
public type UsageTypeCreateEnum "price"|"percentage";

# Full item details
public type Item record {
    # Optional, stock keeping unit to link the item to other inventory systems
    @jsondata:Name {value: "external_sku"}
    string externalSku?;
    # Unique code to identify the item
    @constraint:String {maxLength: 50, pattern: re `^[a-z0-9_+-]+$`}
    string code?;
    # The ID of a performance obligation. Performance obligations are
    # only accessible as a part of the Recurly RevRec Standard and
    # Recurly RevRec Advanced features
    @jsondata:Name {value: "performance_obligation_id"}
    string performanceObligationId?;
    # `true` exempts tax on the item, `false` applies tax on the item
    @jsondata:Name {value: "tax_exempt"}
    boolean taxExempt?;
    @jsondata:Name {value: "custom_fields"}
    CustomFields customFields?;
    # Optional, description
    string description?;
    @jsondata:Name {value: "revenue_schedule_type"}
    RevenueScheduleTypeEnum revenueScheduleType?;
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # Used by Avalara for Communications taxes. The transaction type in combination with the service type describe how the item is taxed. Refer to [the documentation](https://help.avalara.com/AvaTax_for_Communications/Tax_Calculation/AvaTax_for_Communications_Tax_Engine/Mapping_Resources/TM_00115_AFC_Modules_Corresponding_Transaction_Types) for more available t/s types
    @jsondata:Name {value: "avalara_transaction_type"}
    int avalaraTransactionType?;
    @jsondata:Name {value: "deleted_at"}
    string deletedAt?;
    # Accounting code for invoice line items
    @jsondata:Name {value: "accounting_code"}
    string accountingCode?;
    # Optional field used by Avalara, Vertex, and Recurly's In-the-Box tax solution to determine taxation rules. You can pass in specific tax codes using any of these tax integrations. For Recurly's In-the-Box tax offering you can also choose to instead use simple values of `unknown`, `physical`, or `digital` tax codes
    @jsondata:Name {value: "tax_code"}
    string taxCode?;
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # Used by Avalara for Communications taxes. The transaction type in combination with the service type describe how the item is taxed. Refer to [the documentation](https://help.avalara.com/AvaTax_for_Communications/Tax_Calculation/AvaTax_for_Communications_Tax_Engine/Mapping_Resources/TM_00115_AFC_Modules_Corresponding_Transaction_Types) for more available t/s types
    @jsondata:Name {value: "avalara_service_type"}
    int avalaraServiceType?;
    # This name describes your item and will appear on the invoice when it's purchased on a one time basis
    @constraint:String {maxLength: 255}
    string name?;
    @constraint:String {maxLength: 13}
    string id?;
    ActiveStateEnum state?;
    # The Harmonized System (HS) code is an internationally standardized system of names and numbers to classify traded products. The HS code, sometimes called Commodity Code, is used by customs authorities around the world to identify products when assessing duties and taxes. The HS code may also be referred to as the tariff code or customs code. Values should contain only digits and decimals
    @jsondata:Name {value: "harmonized_system_code"}
    string harmonizedSystemCode?;
    # The ID of a general ledger account. General ledger accounts are
    # only accessible as a part of the Recurly RevRec Standard and
    # Recurly RevRec Advanced features
    @jsondata:Name {value: "revenue_gl_account_id"}
    string revenueGlAccountId?;
    string 'object?;
    # The ID of a general ledger account. General ledger accounts are
    # only accessible as a part of the Recurly RevRec Standard and
    # Recurly RevRec Advanced features
    @jsondata:Name {value: "liability_gl_account_id"}
    string liabilityGlAccountId?;
    Pricing[] currencies?;
};

public type TransactionPaymentGateway record {
    string name?;
    string id?;
    string 'type?;
    string 'object?;
};

public type FullCreditReasonCodeEnum "general"|"gift_card"|"promotional"|"refund"|"service"|"write_off";

public type AddOnPricing record {
    # Allows up to 9 decimal places.
    # If `unit_amount_decimal` is provided, `unit_amount` cannot be provided
    @jsondata:Name {value: "unit_amount_decimal"}
    string unitAmountDecimal?;
    # This field is deprecated. Please do not use it
    # 
    # # Deprecated
    @jsondata:Name {value: "tax_inclusive"}
    @deprecated
    boolean taxInclusive = false;
    # 3-letter ISO 4217 currency code
    @constraint:String {maxLength: 3}
    string currency;
    # Allows up to 2 decimal places. Required unless `unit_amount_decimal` is provided
    @jsondata:Name {value: "unit_amount"}
    float unitAmount?;
};

# Represents the Queries record for the operation: listPriceSegments
public type ListPriceSegmentsQueries record {
    # Limit number of records 1-200
    @constraint:Int {minValue: 1, maxValue: 200}
    int 'limit = 20;
    # Filter results by their IDs. Up to 200 IDs can be passed at once using
    # commas as separators, e.g. `ids=h1at4d57xlmy,gyqgg0d3v9n1,jrsm5b4yefg6`.
    # 
    # **Important notes:**
    # 
    # * The `ids` parameter cannot be used with any other ordering or filtering
    #   parameters (`limit`, `order`, `sort`, `begin_time`, `end_time`, etc)
    # * Invalid or unknown IDs will be ignored, so you should check that the
    #   results correspond to your request.
    # * Records are returned in an arbitrary order. Since results are all
    #   returned at once you can sort the records yourself
    string[] ids?;
    # Sort order
    AlphanumericSortEnum 'order?;
};

# Represents the Queries record for the operation: listInvoiceLineItems
public type ListInvoiceLineItemsQueries record {
    # Filter by original field
    TrueEnum original?;
    # Limit number of records 1-200
    @constraint:Int {minValue: 1, maxValue: 200}
    int 'limit = 20;
    # Inclusively filter by end_time when `sort=created_at` or `sort=updated_at`.
    # **Note:** this value is an ISO8601 timestamp. A partial timestamp that does not include a time zone will default to UTC
    @http:Query {name: "end_time"}
    string endTime?;
    # Filter results by their IDs. Up to 200 IDs can be passed at once using
    # commas as separators, e.g. `ids=h1at4d57xlmy,gyqgg0d3v9n1,jrsm5b4yefg6`.
    # 
    # **Important notes:**
    # 
    # * The `ids` parameter cannot be used with any other ordering or filtering
    #   parameters (`limit`, `order`, `sort`, `begin_time`, `end_time`, etc)
    # * Invalid or unknown IDs will be ignored, so you should check that the
    #   results correspond to your request.
    # * Records are returned in an arbitrary order. Since results are all
    #   returned at once you can sort the records yourself
    string[] ids?;
    # Inclusively filter by begin_time when `sort=created_at` or `sort=updated_at`.
    # **Note:** this value is an ISO8601 timestamp. A partial timestamp that does not include a time zone will default to UTC
    @http:Query {name: "begin_time"}
    string beginTime?;
    # Sort field. You *really* only want to sort by `updated_at` in ascending
    # order. In descending order updated records will move behind the cursor and could
    # prevent some records from being returned
    TimestampSortEnum sort?;
    # Filter by state field
    LineItemStateEnum state?;
    # Filter by type field
    LineItemTypeEnum 'type?;
    # Sort order
    AlphanumericSortEnum 'order?;
};

public type OriginEnum "carryforward_credit"|"carryforward_gift_credit"|"credit"|"external_refund"|"gift_card"|"immediate_change"|"import"|"line_item_refund"|"open_amount_refund"|"prepayment"|"purchase"|"refund"|"renewal"|"termination"|"usage_correction"|"write_off";

public type Subscription record {
    # When the subscription was converted from a gift card
    @jsondata:Name {value: "converted_at"}
    string convertedAt?;
    @jsondata:Name {value: "price_segment_id"}
    PriceSegmentIdOrCode priceSegmentId?;
    # Action result params to be used in Recurly-JS to complete a payment when using asynchronous payment methods, e.g., Boleto, iDEAL and Sofort
    @jsondata:Name {value: "action_result"}
    record {} actionResult?;
    @jsondata:Name {value: "canceled_at"}
    string canceledAt?;
    # The UUID is useful for matching data with the CSV exports and building URLs into Recurly's UI
    @constraint:String {maxLength: 32}
    string uuid?;
    # If `auto_renew=true`, when a term completes, `total_billing_cycles` takes this value as the length of subsequent terms. Defaults to the plan's `total_billing_cycles`
    @jsondata:Name {value: "renewal_billing_cycles"}
    int renewalBillingCycles?;
    @jsondata:Name {value: "pending_change"}
    SubscriptionChange pendingChange?;
    # Null unless subscription is paused or will pause at the end of the current billing period
    @jsondata:Name {value: "paused_at"}
    string pausedAt?;
    SubscriptionShipping shipping?;
    # The date the subscription billing resumes following a pause. Null unless the subscription is paused or scheduled to be paused
    @jsondata:Name {value: "resume_at"}
    string resumeAt?;
    @constraint:String {maxLength: 13}
    string id?;
    SubscriptionStateEnum state?;
    # The ID of the business entity associated with the subscription. This will be `null` if the subscription relies on resolving the business entity during renewal
    @jsondata:Name {value: "business_entity_id"}
    string businessEntityId?;
    # Just the important parts
    PlanMini plan?;
    # Billing Info ID
    @jsondata:Name {value: "billing_info_id"}
    string billingInfoId?;
    @jsondata:Name {value: "custom_fields"}
    CustomFields customFields?;
    # Determines whether or not tax is included in the unit amount. The Tax Inclusive Pricing feature (separate from the Mixed Tax Pricing feature) must be enabled to utilize this flag
    @jsondata:Name {value: "tax_inclusive"}
    boolean taxInclusive?;
    # Only for merchants using Recurly's In-The-Box taxes
    float tax?;
    @jsondata:Name {value: "unit_amount"}
    float unitAmount?;
    @jsondata:Name {value: "terms_and_conditions"}
    string termsAndConditions?;
    @jsondata:Name {value: "activated_at"}
    string activatedAt?;
    @jsondata:Name {value: "expiration_reason"}
    string expirationReason?;
    # Returns subscription level coupon redemptions that are tied to this subscription
    @jsondata:Name {value: "coupon_redemptions"}
    CouponRedemptionMini[] couponRedemptions?;
    @jsondata:Name {value: "tax_info"}
    TaxInfo taxInfo?;
    @jsondata:Name {value: "add_ons_total"}
    float addOnsTotal?;
    @constraint:Float {minValue: 0}
    float subtotal?;
    @jsondata:Name {value: "trial_started_at"}
    string trialStartedAt?;
    # The ramp intervals representing the pricing schedule for the subscription
    @jsondata:Name {value: "ramp_intervals"}
    SubscriptionRampIntervalResponse[] rampIntervals?;
    # Null unless subscription is paused or will pause at the end of the current billing period
    @jsondata:Name {value: "remaining_pause_cycles"}
    int remainingPauseCycles?;
    # If present, this subscription's transactions will use the payment gateway with this code
    @jsondata:Name {value: "gateway_code"}
    string gatewayCode?;
    # The invoice ID of the latest invoice created for an active subscription
    @jsondata:Name {value: "active_invoice_id"}
    string activeInvoiceId?;
    string 'object?;
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    @jsondata:Name {value: "current_period_ends_at"}
    string currentPeriodEndsAt?;
    @jsondata:Name {value: "net_terms_type"}
    NetTermsTypeEnum netTermsType?;
    @jsondata:Name {value: "current_period_started_at"}
    string currentPeriodStartedAt?;
    float total?;
    # For manual invoicing, this identifies the PO number associated with the subscription
    @jsondata:Name {value: "po_number"}
    string poNumber?;
    # The start date of the term when the first billing period starts. The subscription term is the length of time that a customer will be committed to a subscription. A term can span multiple billing periods
    @jsondata:Name {value: "current_term_started_at"}
    string currentTermStartedAt?;
    @jsondata:Name {value: "expires_at"}
    string expiresAt?;
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # Recurring subscriptions paid with ACH will have this attribute set. This timestamp is used for alerting customers to reauthorize in 3 years in accordance with NACHA rules. If a subscription becomes inactive or the billing info is no longer a bank account, this timestamp is cleared
    @jsondata:Name {value: "bank_account_authorized_at"}
    string bankAccountAuthorizedAt?;
    @jsondata:Name {value: "add_ons"}
    SubscriptionAddOn[] addOns?;
    # 3-letter ISO 4217 currency code
    @constraint:String {maxLength: 3}
    string currency?;
    # Integer paired with `Net Terms Type` and representing the number
    # of days past the current date (for `net` Net Terms Type) or days after
    # the last day of the current month (for `eom` Net Terms Type) that the
    # invoice will become past due. For `manual` collection method, an additional 24 hours is
    # added to ensure the customer has the entire last day to make payment before
    # becoming past due. For example:
    # 
    # If an invoice is due `net 0`, it is due 'On Receipt' and will become past due 24 hours after it's created.
    # If an invoice is due `net 30`, it will become past due at 31 days exactly.
    # If an invoice is due `eom 30`, it will become past due 31 days from the last day of the current month.
    # 
    # For `automatic` collection method, the additional 24 hours is not added. For example, On-Receipt is due immediately, and `net 30` will become due exactly 30 days from invoice generation, at which point Recurly will attempt collection.
    # When `eom` Net Terms Type is passed, the value for `Net Terms` is restricted to `0, 15, 30, 45, 60, or 90`.
    # 
    # For more information on how net terms work with `manual` collection visit our docs page (https://docs.recurly.com/docs/manual-payments#section-collection-terms)
    # or visit (https://docs.recurly.com/docs/automatic-invoicing-terms#section-collection-terms) for information about net terms using `automatic` collection
    @jsondata:Name {value: "net_terms"}
    int netTerms = 0;
    # The number of cycles/billing periods in a term. When `remaining_billing_cycles=0`, if `auto_renew=true` the subscription will renew and a new term will begin, otherwise the subscription will expire
    @jsondata:Name {value: "total_billing_cycles"}
    int totalBillingCycles?;
    # The remaining billing cycles in the current term
    @jsondata:Name {value: "remaining_billing_cycles"}
    int remainingBillingCycles?;
    @constraint:Int {minValue: 0}
    int quantity?;
    # When the term ends. This is calculated by a plan's interval and `total_billing_cycles` in a term. Subscription changes with a `timeframe=renewal` will be applied on this date
    @jsondata:Name {value: "current_term_ends_at"}
    string currentTermEndsAt?;
    @jsondata:Name {value: "revenue_schedule_type"}
    RevenueScheduleTypeEnum revenueScheduleType?;
    @jsondata:Name {value: "customer_notes"}
    string customerNotes?;
    # Whether the subscription was started with a gift certificate
    @jsondata:Name {value: "started_with_gift"}
    boolean startedWithGift = false;
    # Whether the subscription renews at the end of its term
    @jsondata:Name {value: "auto_renew"}
    boolean autoRenew = true;
    @jsondata:Name {value: "credit_application_policy"}
    CreditApplicationPolicy creditApplicationPolicy?;
    @jsondata:Name {value: "collection_method"}
    CollectionMethodEnum collectionMethod?;
    @jsondata:Name {value: "trial_ends_at"}
    string trialEndsAt?;
    AccountMini account?;
};

public type ShippingAddressCreate record {
    # Country, 2-letter ISO 3166-1 alpha-2 code
    @constraint:String {maxLength: 50}
    string country;
    @constraint:String {maxLength: 255}
