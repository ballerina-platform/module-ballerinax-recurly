# Invoice from an external resource such as Apple App Store or Google Play Store
public type ExternalInvoice record {
    string total?;
    # When the invoice was created in the external platform
    @jsondata:Name {value: "purchased_at"}
    string purchasedAt?;
    # When the external invoice was updated in Recurly
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    @jsondata:Name {value: "external_subscription"}
    ExternalSubscription externalSubscription?;
    # When the external invoice was created in Recurly
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # An identifier which associates the external invoice to a corresponding object in an external platform
    @jsondata:Name {value: "external_id"}
    string externalId?;
    # 3-letter ISO 4217 currency code
    string currency?;
    # System-generated unique identifier for an external invoice ID, e.g. `e28zov4fw0v2`
    string id?;
    ExternalInvoiceStateEnum state?;
    @jsondata:Name {value: "line_items"}
    ExternalCharge[] lineItems?;
    AccountMini account?;
    string 'object?;
};

