# The price segment ID, e.g. `e28zov4fw0v2`
@constraint:String {maxLength: 50}
public type PriceSegmentId string;

# Unique code to identify the plan. This is used in Hosted Payment Page URLs and in the invoice exports
@constraint:String {maxLength: 50, pattern: re `^[a-z0-9_+-]+$`}
public type PlanCode string;

public type LineItem record {
    # The ID of a performance obligation. Performance obligations are
    # only accessible as a part of the Recurly RevRec Standard and
    # Recurly RevRec Advanced features
    @jsondata:Name {value: "performance_obligation_id"}
    string performanceObligationId?;
    # If the line item is a charge or credit for a plan or add-on, this is the plan's code
    @jsondata:Name {value: "plan_code"}
    string planCode?;
    # The sum of all discounts applied to the line item
    float discount?;
    LineItemTypeEnum 'type?;
    # Unique code to identify the ledger account. Each code must start
    # with a letter or number. The following special characters are
    # allowed: `-_.,:`
    @jsondata:Name {value: "revenue_gl_account_code"}
    string revenueGlAccountCode?;
    # The UUID is useful for matching data with the CSV exports and building URLs into Recurly's UI
    @constraint:String {maxLength: 32}
    string uuid?;
    # If the line item is a charge or credit for a subscription, this is its ID
    @jsondata:Name {value: "subscription_id"}
    string subscriptionId?;
    # The breakdown of discounts applied to the line item by coupon redemption
    LineItemDiscount[] discounts?;
    # Once the line item has been invoiced this will be the invoice's ID
    @jsondata:Name {value: "invoice_id"}
    string invoiceId?;
    @constraint:String {maxLength: 13}
    string id?;
    LineItemStateEnum state?;
    @jsondata:Name {value: "legacy_category"}
    LegacyCategoryEnum legacyCategory?;
    # Once the line item has been invoiced this will be the invoice's number. If VAT taxation and the Country Invoice Sequencing feature are enabled, invoices will have country-specific invoice numbers for invoices billed to EU countries (ex: FR1001). Non-EU invoices will continue to use the site-level invoice number sequence
    @jsondata:Name {value: "invoice_number"}
    string invoiceNumber?;
    # Will only have a value if the line item is a credit created from a previous credit, or if the credit was created from a charge refund
    @jsondata:Name {value: "previous_line_item_id"}
    string previousLineItemId?;
    # `true` if the line item is taxable, `false` if it is not
    boolean taxable?;
    # `true` exempts tax on charges, `false` applies tax on charges. If not defined, then defaults to the Plan and Site settings. This attribute does not work for credits (negative line items). Credits are always applied post-tax. Pre-tax discounts should use the Coupons feature
    @jsondata:Name {value: "tax_exempt"}
    boolean taxExempt?;
    @jsondata:Name {value: "custom_fields"}
    CustomFields customFields?;
    # Positive amount for a charge, negative amount for a credit
    @jsondata:Name {value: "unit_amount_decimal"}
    string unitAmountDecimal?;
    # Determines whether or not tax is included in the unit amount. The Tax Inclusive Pricing feature (separate from the Mixed Tax Pricing feature) must be enabled to utilize this flag
    @jsondata:Name {value: "tax_inclusive"}
    boolean taxInclusive?;
    # The tax amount for the line item
    float tax?;
    # Used by Avalara for Communications taxes. The transaction type in combination with the service type describe how the line item is taxed. Refer to [the documentation](https://help.avalara.com/AvaTax_for_Communications/Tax_Calculation/AvaTax_for_Communications_Tax_Engine/Mapping_Resources/TM_00115_AFC_Modules_Corresponding_Transaction_Types) for more available t/s types
    @jsondata:Name {value: "avalara_transaction_type"}
    int avalaraTransactionType?;
    # Positive amount for a charge, negative amount for a credit
    @jsondata:Name {value: "unit_amount"}
    float unitAmount?;
    # The UUID of the account responsible for originating the line item
    @jsondata:Name {value: "bill_for_account_id"}
    string billForAccountId?;
    @jsondata:Name {value: "credit_reason_code"}
    FullCreditReasonCodeEnum creditReasonCode?;
    @jsondata:Name {value: "tax_info"}
    TaxInfo taxInfo?;
    # `quantity * unit_amount`
    float subtotal?;
    # If the line item is a charge or credit for an add-on, this is its code
    @jsondata:Name {value: "add_on_code"}
    string addOnCode?;
    @jsondata:Name {value: "vertex_transaction_type"}
    VertexTransactionTypeEnum vertexTransactionType?;
    # The Harmonized System (HS) code is an internationally standardized system of names and numbers to classify traded products. The HS code, sometimes called Commodity Code, is used by customs authorities around the world to identify products when assessing duties and taxes. The HS code may also be referred to as the tariff code or customs code. Values should contain only digits and decimals
    @jsondata:Name {value: "harmonized_system_code"}
    string harmonizedSystemCode?;
    @jsondata:Name {value: "destination_tax_address_source"}
    DestinationTaxAddressSourceEnum destinationTaxAddressSource?;
    string 'object?;
    boolean refund?;
    # Optional Stock Keeping Unit assigned to an item. Available when the Credit Invoices feature is enabled
    @jsondata:Name {value: "external_sku"}
    string externalSku?;
    # If this date is provided, it indicates the end of a time range
    @jsondata:Name {value: "end_date"}
    string endDate?;
    # Unique code to identify an item. Available when the Credit Invoices feature is enabled
    @jsondata:Name {value: "item_code"}
    string itemCode?;
    # The amount of credit from this line item that was applied to the invoice
    @jsondata:Name {value: "credit_applied"}
    float creditApplied?;
    LineItemOriginEnum origin?;
    # Description that appears on the invoice. For subscription related items this will be filled in automatically
    @constraint:String {maxLength: 255}
    string description?;
    # When the line item was created
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # For plan-related line items this will be the plan's code, for add-on related line items it will be the add-on's code. For item-related line items it will be the item's `external_sku`
    @jsondata:Name {value: "product_code"}
    string productCode?;
    # Unique code to identify the ledger account. Each code must start
    # with a letter or number. The following special characters are
    # allowed: `-_.,:`
    @jsondata:Name {value: "liability_gl_account_code"}
    string liabilityGlAccountCode?;
    # When the line item was last changed
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # Used by Avalara for Communications taxes. The transaction type in combination with the service type describe how the line item is taxed. Refer to [the documentation](https://help.avalara.com/AvaTax_for_Communications/Tax_Calculation/AvaTax_for_Communications_Tax_Engine/Mapping_Resources/TM_00115_AFC_Modules_Corresponding_Transaction_Types) for more available t/s types
    @jsondata:Name {value: "avalara_service_type"}
    int avalaraServiceType?;
    # For refund charges, the quantity being refunded. For non-refund charges, the total quantity refunded (possibly over multiple refunds)
    @jsondata:Name {value: "refunded_quantity"}
    int refundedQuantity?;
    # 3-letter ISO 4217 currency code
    @constraint:String {maxLength: 3}
    string currency?;
    @jsondata:Name {value: "shipping_address"}
    ShippingAddress shippingAddress?;
    # A floating-point alternative to Refunded Quantity. For refund charges, the quantity being refunded. For non-refund charges, the total quantity refunded (possibly over multiple refunds). The Decimal Quantity feature must be enabled to utilize this field
    @jsondata:Name {value: "refunded_quantity_decimal"}
    string refundedQuantityDecimal?;
    # If an end date is present, this is value indicates the beginning of a billing time range. If no end date is present it indicates billing for a specific date
    @jsondata:Name {value: "start_date"}
    string startDate?;
    # `(quantity * unit_amount) - discount + tax`
    float amount?;
    # If the line item is a charge or credit for an add-on this is its ID
    @jsondata:Name {value: "add_on_id"}
    string addOnId?;
    # This number will be multiplied by the unit amount to compute the subtotal before any discounts or taxes
    int quantity = 1;
    # System-generated unique identifier for an item. Available when the Credit Invoices feature is enabled
    @jsondata:Name {value: "item_id"}
    string itemId?;
    # When a line item has been prorated, this is the rate of the proration. Proration rates were made available for line items created after March 30, 2017. For line items created prior to that date, the proration rate will be `null`, even if the line item was prorated
    @jsondata:Name {value: "proration_rate"}
    float prorationRate?;
    @jsondata:Name {value: "revenue_schedule_type"}
    LineItemRevenueScheduleTypeEnum revenueScheduleType?;
    # Internal accounting code to help you reconcile your revenue to the correct ledger. Line items created as part of a subscription invoice will use the plan or add-on's accounting code, otherwise the value will only be present if you define an accounting code when creating the line item
    @jsondata:Name {value: "accounting_code"}
    string accountingCode?;
    # Optional field used by Avalara, Vertex, and Recurly's In-the-Box tax solution to determine taxation rules. You can pass in specific tax codes using any of these tax integrations. For Recurly's In-the-Box tax offering you can also choose to instead use simple values of `unknown`, `physical`, or `digital` tax codes
    @jsondata:Name {value: "tax_code"}
    string taxCode?;
    @jsondata:Name {value: "origin_tax_address_source"}
    OriginTaxAddressSourceEnum originTaxAddressSource?;
    # A floating-point alternative to Quantity. If this value is present, it will be used in place of Quantity for calculations, and Quantity will be the rounded integer value of this number. This field supports up to 9 decimal places. The Decimal Quantity feature must be enabled to utilize this field
    @jsondata:Name {value: "quantity_decimal"}
    string quantityDecimal?;
    # The invoice where the credit originated. Will only have a value if the line item is a credit created from a previous credit, or if the credit was created from a charge refund
    @jsondata:Name {value: "original_line_item_invoice_id"}
    string originalLineItemInvoiceId?;
    AccountMini account?;
    # If the line item is a charge or credit for a plan or add-on, this is the plan's ID
    @jsondata:Name {value: "plan_id"}
    string planId?;
};

# Determines how the amount charged is determined for this change
public type ProrationSettingsChargeEnum "full_amount"|"prorated_amount"|"none";

public type CouponRedemption record {
    # The amount that was discounted upon the application of the coupon, formatted with the currency
    float discounted?;
    Coupon coupon?;
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    @jsondata:Name {value: "remaining_duration"}
    CouponRedemptionRemainingDuration remainingDuration?;
    # The UUID is useful for matching data with the CSV exports and building URLs into Recurly's UI
    @constraint:String {maxLength: 32}
    string uuid?;
    @jsondata:Name {value: "subscription_id"}
    string subscriptionId?;
    # The date and time the redemption was removed from the account (un-redeemed)
    @jsondata:Name {value: "removed_at"}
    string removedAt?;
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # 3-letter ISO 4217 currency code
    @constraint:String {maxLength: 3}
    string currency?;
    string id?;
    ActiveStateEnum state?;
    AccountMini account?;
    # Will always be `coupon`
    string 'object?;
};

# Represents the Queries record for the operation: listAccountExternalInvoices
public type ListAccountExternalInvoicesQueries record {
    # Limit number of records 1-200
    @constraint:Int {minValue: 1, maxValue: 200}
    int 'limit = 20;
    # Sort field. You *really* only want to sort by `updated_at` in ascending
    # order. In descending order updated records will move behind the cursor and could
    # prevent some records from being returned
    TimestampSortEnum sort?;
    # Sort order
    AlphanumericSortEnum 'order?;
};

# Settings for a dunning campaign
public type DunningCampaign record {
    # Campaign code
    string code?;
    # When the current campaign was updated in Recurly
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # Campaign name
    string name?;
    # Campaign description
    string description?;
    # When the current campaign was created in Recurly
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    string id?;
    # Dunning Cycle settings
    @jsondata:Name {value: "dunning_cycles"}
    DunningCycle[] dunningCycles?;
    # When the current campaign was deleted in Recurly
    @jsondata:Name {value: "deleted_at"}
    string deletedAt?;
    # Whether or not this is the default campaign for accounts or plans without an assigned dunning campaign
    @jsondata:Name {value: "default_campaign"}
    boolean defaultCampaign?;
    string 'object?;
};

public type CustomerPermission record {
    # Customer permission code
    string code?;
    # Customer permission name
    string name?;
    # Description of customer permission
    string description?;
    # Customer permission ID
    string id?;
    # It will always be "customer_permission"
    string 'object?;
};

public type UserAccessEnum "api_only"|"read_only"|"write"|"set_only";

public type CustomField record {
    # The UUID of the record this custom field was automatically copied from. Only present when the field was copied from another record
    @jsondata:Name {value: "source_record_id"}
    string sourceRecordId?;
    # Fields must be created in the UI before values can be assigned to them
    @constraint:String {maxLength: 50, pattern: re `^[a-zA-Z0-9_-]+$`}
    string name;
    # Any values that resemble a credit card number or security code (CVV/CVC) will be rejected
    @constraint:String {maxLength: 255}
    string value;
    @jsondata:Name {value: "source_record_type"}
    SourceRecordTypeEnum sourceRecordType?;
};

# Create a new liability or revenue general ledger account
public type GeneralLedgerAccountCreate record {
    @jsondata:Name {value: "account_type"}
    GeneralLedgerAccountTypeEnum accountType?;
    # Unique code to identify the ledger account. Each code must start
    # with a letter or number. The following special characters are
    # allowed: `-_.,:`
    @constraint:String {maxLength: 255, pattern: re `^[A-Za-z0-9](( *)?[\-A-Za-z0-9_.,:])*$`}
    string code?;
    # Optional description
    @constraint:String {maxLength: 255}
    string description?;
};
