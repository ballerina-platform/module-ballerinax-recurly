    string 'object?;
};

# Used to determine where the associated add-on data is pulled from. If this value is set to
# `plan_add_on` or left blank, then add-on data will be pulled from the plan's add-ons. If the associated
# `plan` has `allow_any_item_on_subscriptions` set to `true` and this field is set to `item`, then
# the associated add-on data will be pulled from the site's item catalog
public type AddOnSourceEnum "plan_add_on"|"item";

# A purchase is only a request data type and is not persistent in Recurly, an InvoiceCollection will be the returned type
public type PurchaseCreate record {
    # A list of subscriptions to be created with the purchase
    SubscriptionPurchase[] subscriptions?;
    # The `business_entity_code` is the value that represents a specific business entity for an end customer. When `business_entity_code` is used to assign a business entity to the subscription, all future billing events for the subscription will bill to the specified business entity. Available when the `Multiple Business Entities` feature is enabled. If both `business_entity_id` and `business_entity_code` are present, `business_entity_id` will be used
    @jsondata:Name {value: "business_entity_code"}
    string businessEntityCode?;
    @jsondata:Name {value: "net_terms_type"}
    NetTermsTypeEnum netTermsType?;
    # A list of one time charges or credits to be created with the purchase
    @jsondata:Name {value: "line_items"}
    LineItemCreate[] lineItems?;
    @jsondata:Name {value: "customer_notes"}
    string customerNotes?;
    # Notes to be put on the credit invoice resulting from credits in the purchase, if any
    @jsondata:Name {value: "credit_customer_notes"}
    string creditCustomerNotes?;
    @jsondata:Name {value: "transaction_type"}
    GatewayTransactionTypeEnum transactionType?;
    @jsondata:Name {value: "credit_application_policy_override"}
    CreditApplicationPolicy creditApplicationPolicyOverride?;
    # VAT reverse charge notes for cross border European tax settlement
    @jsondata:Name {value: "vat_reverse_charge_notes"}
    string vatReverseChargeNotes?;
    # Terms and conditions to be put on the purchase invoice
    @jsondata:Name {value: "terms_and_conditions"}
    string termsAndConditions?;
    # For manual invoicing, this identifies the PO number associated with the subscription
    @jsondata:Name {value: "po_number"}
    string poNumber?;
    PurchaseCreateShipping shipping?;
    # A gift card redemption code to be redeemed on the purchase invoice
    @jsondata:Name {value: "gift_card_redemption_code"}
    string giftCardRedemptionCode?;
    @jsondata:Name {value: "collection_method"}
    CollectionMethodEnum collectionMethod?;
    # 3-letter ISO 4217 currency code
    @constraint:String {maxLength: 3}
    string currency;
    # Integer paired with `Net Terms Type` and representing the number
    # of days past the current date (for `net` Net Terms Type) or days after
    # the last day of the current month (for `eom` Net Terms Type) that the
    # invoice will become past due. For `manual` collection method, an additional 24 hours is
    # added to ensure the customer has the entire last day to make payment before
    # becoming past due. For example:
    # 
    # If an invoice is due `net 0`, it is due 'On Receipt' and will become past due 24 hours after it's created.
    # If an invoice is due `net 30`, it will become past due at 31 days exactly.
    # If an invoice is due `eom 30`, it will become past due 31 days from the last day of the current month.
    # 
    # For `automatic` collection method, the additional 24 hours is not added. For example, On-Receipt is due immediately, and `net 30` will become due exactly 30 days from invoice generation, at which point Recurly will attempt collection.
    # When `eom` Net Terms Type is passed, the value for `Net Terms` is restricted to `0, 15, 30, 45, 60, or 90`.
    # 
    # For more information on how net terms work with `manual` collection visit our docs page (https://docs.recurly.com/docs/manual-payments#section-collection-terms)
    # or visit (https://docs.recurly.com/docs/automatic-invoicing-terms#section-collection-terms) for information about net terms using `automatic` collection
    @jsondata:Name {value: "net_terms"}
    int netTerms = 0;
    @jsondata:Name {value: "vertex_transaction_type"}
    VertexTransactionTypeEnum vertexTransactionType?;
    # The `business_entity_id` is the value that represents a specific business entity for an end customer. When `business_entity_id` is used to assign a business entity to the subscription, all future billing events for the subscription will bill to the specified business entity. Available when the `Multiple Business Entities` feature is enabled. If both `business_entity_id` and `business_entity_code` are present, `business_entity_id` will be used
    @jsondata:Name {value: "business_entity_id"}
    string businessEntityId?;
    # The default payment gateway identifier to be used for the purchase transaction.  This will also be applied as the default for any subscriptions included in the purchase request
    @jsondata:Name {value: "gateway_code"}
    string gatewayCode?;
    # A list of coupon_codes to be redeemed on the subscription or account during the purchase
    @jsondata:Name {value: "coupon_codes"}
    string[] couponCodes?;
    AccountPurchase account;
    # (Transaction Data, Card on File) - Options for flagging transactions as Customer or Merchant Initiated Unscheduled
    record {TransactionInitiatorEnum initiator?; TransactionMerchantReasonCodeEnum merchant_reason_code?; boolean skip_gateway_fraud?; boolean skip_recurly_fraud?; boolean skip_all_fraud?; string descriptor_suffix?;} 'transaction?;
    # The `billing_info_id` is the value that represents a specific billing info for an end customer. When `billing_info_id` is used to assign billing info to the subscription, all future billing events for the subscription will bill to the specified billing info. `billing_info_id` can ONLY be used for sites utilizing the Wallet feature
    @jsondata:Name {value: "billing_info_id"}
    string billingInfoId?;
};

# Settings for an invoice template
public type InvoiceTemplate record {
    # Invoice template code
    string code?;
    # When the invoice template was updated in Recurly
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # Invoice template name
    string name?;
    # Invoice template description
    string description?;
    # When the invoice template was created in Recurly
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    string id?;
};

public type SubscriptionPause record {
    # Number of billing cycles to pause the subscriptions. A value of 0 will cancel any pending pauses on the subscription
    @jsondata:Name {value: "remaining_pause_cycles"}
    int remainingPauseCycles;
};

public type ChannelEnum "advertising"|"blog"|"direct_traffic"|"email"|"events"|"marketing_content"|"organic_search"|"other"|"outbound_sales"|"paid_search"|"public_relations"|"referral"|"social_media";

public type TaxDetail record {
    # Provides the tax rate for the region
    float rate?;
    # Provides the jurisdiction level for the Communications tax applied. Example values include city, state and federal. Present only when Avalara for Communications or Vertex is enabled
    string level?;
    # Provides the name of the Communications tax applied. Present only when Avalara for Communications or Vertex is enabled
    string name?;
    # The total tax applied for this tax type
    float tax?;
    # Provides the tax type for the region or type of Comminications tax when Avalara for Communications or Vertex is enabled. For Canadian Sales Tax, this will be GST, HST, QST or PST
    string 'type?;
    # Provides the tax region applied on an invoice. For Canadian Sales Tax, this will be either the 2 letter province code or country code. Not present when Avalara for Communications is enabled
    string region?;
    # Whether or not the line item is taxable. Only populated for a single LineItem fetch when Avalara for Communications or Vertex is enabled
    boolean billable?;
};

# This field is deprecated. Please do not use it
# 
