    string deletedAt?;
    string email?;
    string 'object?;
};

# Represents the Queries record for the operation: listSubscriptionInvoices
public type ListSubscriptionInvoicesQueries record {
    # Limit number of records 1-200
    @constraint:Int {minValue: 1, maxValue: 200}
    int 'limit = 20;
    # Inclusively filter by end_time when `sort=created_at` or `sort=updated_at`.
    # **Note:** this value is an ISO8601 timestamp. A partial timestamp that does not include a time zone will default to UTC
    @http:Query {name: "end_time"}
    string endTime?;
    # Filter results by their IDs. Up to 200 IDs can be passed at once using
    # commas as separators, e.g. `ids=h1at4d57xlmy,gyqgg0d3v9n1,jrsm5b4yefg6`.
    # 
    # **Important notes:**
    # 
    # * The `ids` parameter cannot be used with any other ordering or filtering
    #   parameters (`limit`, `order`, `sort`, `begin_time`, `end_time`, etc)
    # * Invalid or unknown IDs will be ignored, so you should check that the
    #   results correspond to your request.
    # * Records are returned in an arbitrary order. Since results are all
    #   returned at once you can sort the records yourself
    string[] ids?;
    # Inclusively filter by begin_time when `sort=created_at` or `sort=updated_at`.
    # **Note:** this value is an ISO8601 timestamp. A partial timestamp that does not include a time zone will default to UTC
    @http:Query {name: "begin_time"}
    string beginTime?;
    # Invoice state
    InvoiceStateQueryParamEnum state?;
    # Sort field. You *really* only want to sort by `updated_at` in ascending
    # order. In descending order updated records will move behind the cursor and could
    # prevent some records from being returned
    TimestampSortEnum sort?;
    # Filter by type when:
    # - `type=charge`, only charge invoices will be returned.
    # - `type=credit`, only credit invoices will be returned.
    # - `type=non-legacy`, only charge and credit invoices will be returned.
    # - `type=legacy`, only legacy invoices will be returned
    FilterInvoiceTypeEnum 'type?;
    # Sort order
    AlphanumericSortEnum 'order?;
};

public type UsageCreate record {
    # The amount of usage. Can be positive, negative, or 0. If the Decimal Quantity feature is enabled, this value will be rounded to nine decimal places.  Otherwise, all digits after the decimal will be stripped. If the usage-based add-on is billed with a percentage, your usage should be a monetary amount formatted in cents (e.g., $5.00 is "500")
    float amount?;
    # When the usage actually happened. This will define the line item dates this usage is billed under and is important for revenue recognition
    @jsondata:Name {value: "usage_timestamp"}
    string usageTimestamp?;
    # Custom field for recording the id in your own system associated with the usage, so you can provide auditable usage displays to your customers using a GET on this endpoint
    @jsondata:Name {value: "merchant_tag"}
    string merchantTag?;
    # When the usage was recorded in your system
    @jsondata:Name {value: "recording_timestamp"}
    string recordingTimestamp?;
};

public type ExternalAccountUpdate record {
    # Represents the account code for the external account
    @jsondata:Name {value: "external_account_code"}
    string externalAccountCode?;
    # Represents the connection type. One of the connection types of your enabled App Connectors
    @jsondata:Name {value: "external_connection_type"}
    string externalConnectionType?;
};

# Represents the Queries record for the operation: listInvoiceTemplateAccounts
public type ListInvoiceTemplateAccountsQueries record {
    # Filter for accounts with or without a subscription in the `active`,
    # `canceled`, or `future` state
    boolean subscriber?;
    # Limit number of records 1-200
    @constraint:Int {minValue: 1, maxValue: 200}
