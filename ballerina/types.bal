public type Transaction record {
    # For declined (`success=false`) transactions, the message displayed to the merchant
    @jsondata:Name {value: "status_message"}
    string statusMessage?;
    @jsondata:Name {value: "voided_at"}
    string voidedAt?;
    # IP address provided when the billing information was collected:
    # 
    # - When the customer enters billing information into the Recurly.js or Hosted Payment Pages, Recurly records the IP address.
    # - When the merchant enters billing information using the API, the merchant may provide an IP address.
    # - When the merchant enters billing information using the UI, no IP address is recorded
    @jsondata:Name {value: "ip_address_v4"}
    string ipAddressV4?;
    @jsondata:Name {value: "avs_check"}
    AvsCheckEnum avsCheck?;
    # If this transaction is a refund (`type=refund`), this will be the ID of the original transaction on the invoice being refunded
    @jsondata:Name {value: "original_transaction_id"}
    string originalTransactionId?;
    @jsondata:Name {value: "status_code"}
    string statusCode?;
    # Action result params to be used in Recurly-JS to complete a payment when using asynchronous payment methods, e.g., Boleto, iDEAL and Sofort
    @jsondata:Name {value: "action_result"}
    record {} actionResult?;
    @jsondata:Name {value: "ip_address_country"}
    string ipAddressCountry?;
    # VAT number for the customer on this transaction. If the customer's Billing Info country is BR or AR, then this will be their Tax Identifier. For all other countries this will come from the VAT Number field in the Billing Info
    @jsondata:Name {value: "vat_number"}
    string vatNumber?;
    # Must be sent for one-time transactions in order to provide context on which entity is submitting the transaction to ensure proper fraud checks are observed, such as 3DS. If the customer is in session, send `customer`. If this is a merchant initiated one-time transaction, send `merchant`
    TransactionInitiatorEnum initiator?;
    TransactionOriginEnum origin?;
    @jsondata:Name {value: "gateway_approval_code"}
    string gatewayApprovalCode?;
    # The description that gets sent to the gateway
    string description?;
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    @jsondata:Name {value: "billing_address"}
    AddressWithName billingAddress?;
    TransactionTypeEnum 'type?;
    # The UUID is useful for matching data with the CSV exports and building URLs into Recurly's UI
    @constraint:String {maxLength: 32}
    string uuid?;
    @jsondata:Name {value: "customer_message_locale"}
    string customerMessageLocale?;
    @jsondata:Name {value: "cvv_check"}
    CvvCheckEnum cvvCheck?;
    @jsondata:Name {value: "merchant_reason_code"}
    TransactionMerchantReasonCodeEnum merchantReasonCode?;
    # If the transaction is charging or refunding for one or more subscriptions, these are their IDs
    @jsondata:Name {value: "subscription_ids"}
    TransactionSubscriptionidsItemsString[] subscriptionIds?;
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # 3-letter ISO 4217 currency code
    @constraint:String {maxLength: 3}
    string currency?;
    # Indicates if part or all of this transaction was refunded
    boolean refunded?;
    @constraint:String {maxLength: 13}
    string id?;
    # Array of Payment Gateway References captured at transaction time, each a reference to a third-party gateway object of varying types
    @jsondata:Name {value: "payment_gateway_references"}
    PaymentGatewayReferences[] paymentGatewayReferences?;
    @jsondata:Name {value: "payment_method"}
    PaymentMethod paymentMethod?;
    # Time, in seconds, for gateway to process the transaction
    @jsondata:Name {value: "gateway_response_time"}
    float gatewayResponseTime?;
    # Total transaction amount sent to the payment gateway
    float amount?;
    # For declined (`success=false`) transactions, the message displayed to the customer
    @jsondata:Name {value: "customer_message"}
    string customerMessage?;
    @jsondata:Name {value: "payment_gateway"}
    TransactionPaymentGateway paymentGateway?;
    # Transaction reference number from the payment gateway
    @jsondata:Name {value: "gateway_reference"}
    string gatewayReference?;
    # Indicates if the transaction was completed using a backup payment
    @jsondata:Name {value: "backup_payment_method_used"}
    boolean backupPaymentMethodUsed?;
    @jsondata:Name {value: "voided_by_invoice"}
    InvoiceMini voidedByInvoice?;
    @jsondata:Name {value: "collected_at"}
    string collectedAt?;
    # Transaction message from the payment gateway
    @jsondata:Name {value: "gateway_message"}
    string gatewayMessage?;
    @jsondata:Name {value: "fraud_info"}
    TransactionFraudInfo fraudInfo?;
    # Did this transaction complete successfully?
    boolean success?;
    @jsondata:Name {value: "gateway_response_code"}
    string gatewayResponseCode?;
    @jsondata:Name {value: "collection_method"}
    CollectionMethodEnum collectionMethod?;
    @jsondata:Name {value: "next_action"}
    NextAction nextAction?;
    InvoiceMini invoice?;
    AccountMini account?;
    string 'object?;
    TransactionStatusEnum status?;
    # The values in this field will vary from gateway to gateway
    @jsondata:Name {value: "gateway_response_values"}
    record {} gatewayResponseValues?;
};

