    string 'object?;
};

public type PaymentMethodEnum "bacs"|"amazon"|"amazon_billing_agreement"|"apple_pay"|"apple_pay_merchant_token"|"bank_account_info"|"braintree_apple_pay"|"check"|"credit_card"|"eft"|"gateway_token"|"google_pay"|"google_pay_device_pan"|"iban_bank_account"|"money_order"|"other"|"paypal"|"paypal_billing_agreement"|"roku"|"sepadirectdebit"|"venmo"|"wire_transfer"|"braintree_v_zero"|"boleto"|"cash_app"|"upi_autopay"|"pix_automatico"|"mercadopago"|"klarna"|"braintree_google_pay"|"stripe_link";

