# Subscription from an external resource such as Apple App Store or Google Play Store
public type ExternalSubscription record {
    # An indication of the quantity of a subscribed item's quantity
    @constraint:Int {minValue: 0}
    int quantity = 1;
    # An indication of whether or not the external subscription was purchased in a sandbox environment
    boolean test = false;
    @jsondata:Name {value: "external_product_reference"}
    ExternalProductReferenceMini externalProductReference?;
    # When the external subscription was canceled in the external platform
    @jsondata:Name {value: "canceled_at"}
    string canceledAt?;
    # When a new billing event occurred on the external subscription in conjunction with a recent billing period, reactivation or upgrade/downgrade
    @jsondata:Name {value: "last_purchased"}
    string lastPurchased?;
    # When the external subscription was created in Recurly
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # The id of the subscription in the external systems., I.e. Apple App Store or Google Play Store
    @jsondata:Name {value: "external_id"}
    string externalId?;
    # Universally Unique Identifier created automatically
    string uuid?;
    # When the external subscription was activated in the external platform
    @jsondata:Name {value: "activated_at"}
    string activatedAt?;
    # An indication of whether or not the external subscription is in a grace period
    @jsondata:Name {value: "in_grace_period"}
    boolean inGracePeriod = false;
    # When the external subscription expires in the external platform
    @jsondata:Name {value: "expires_at"}
    string expiresAt?;
    # An indication of whether or not the external subscription will auto-renew at the expiration date
    @jsondata:Name {value: "auto_renew"}
    boolean autoRenew = false;
    # When the external subscription was updated in Recurly
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # The phases of the external subscription payment lifecycle
    @jsondata:Name {value: "external_payment_phases"}
    ExternalPaymentPhase[] externalPaymentPhases?;
    # An indication of whether or not the external subscription was created by a historical data import
    boolean imported = false;
    # When the external subscription trial period started in the external platform
    @jsondata:Name {value: "trial_started_at"}
    string trialStartedAt?;
    # When the external subscription trial period ends in the external platform
    @jsondata:Name {value: "trial_ends_at"}
    string trialEndsAt?;
    # System-generated unique identifier for an external subscription ID, e.g. `e28zov4fw0v2`
    string id?;
    # External subscriptions can be active, canceled, expired, past_due, voided, revoked, or paused
    string state = "active";
    # Identifier of the app that generated the external subscription
    @jsondata:Name {value: "app_identifier"}
    string appIdentifier?;
    AccountMini account?;
    string 'object?;
};

public type LineItemCreate record {
    # If this date is provided, it indicates the end of a time range
    @jsondata:Name {value: "end_date"}
    string endDate?;
    # Unique code to identify an item. Available when the Credit Invoices feature is enabled
    @jsondata:Name {value: "item_code"}
    string itemCode?;
    # The ID of a performance obligation. Performance obligations are
    # only accessible as a part of the Recurly RevRec Standard and
    # Recurly RevRec Advanced features
    @jsondata:Name {value: "performance_obligation_id"}
    string performanceObligationId?;
    LineItemCreateOriginEnum origin?;
    # Description that appears on the invoice. If `item_code`/`item_id` is part of the request then `description` must be absent
    @constraint:String {maxLength: 255}
    string description?;
    LineItemTypeEnum 'type;
    # Optional field to track a product code or SKU for the line item. This can be used to later reporting on product purchases. For Vertex tax calculations, this field will be used as the Vertex `product` field. If `item_code`/`item_id` is part of the request then `product_code` must be absent
    @jsondata:Name {value: "product_code"}
    string productCode?;
    # Used by Avalara for Communications taxes. The transaction type in combination with the service type describe how the line item is taxed. Refer to [the documentation](https://help.avalara.com/AvaTax_for_Communications/Tax_Calculation/AvaTax_for_Communications_Tax_Engine/Mapping_Resources/TM_00115_AFC_Modules_Corresponding_Transaction_Types) for more available t/s types. If an `Item` is associated to the `LineItem`, then the `avalara_service_type` must be absent
    @jsondata:Name {value: "avalara_service_type"}
    int avalaraServiceType?;
    # 3-letter ISO 4217 currency code. If `item_code`/`item_id` is part of the request then `currency` is optional, if the site has a single default currency. `currency` is required if `item_code`/`item_id` is present, and there are multiple currencies defined on the site. If `item_code`/`item_id` is not present `currency` is required
    @constraint:String {maxLength: 3}
    string currency;
    # The ID of a general ledger account. General ledger accounts are
    # only accessible as a part of the Recurly RevRec Standard and
    # Recurly RevRec Advanced features
    @jsondata:Name {value: "revenue_gl_account_id"}
    string revenueGlAccountId?;
    # The ID of a general ledger account. General ledger accounts are
    # only accessible as a part of the Recurly RevRec Standard and
    # Recurly RevRec Advanced features
    @jsondata:Name {value: "liability_gl_account_id"}
    string liabilityGlAccountId?;
    # If an end date is present, this is value indicates the beginning of a billing time range. If no end date is present it indicates billing for a specific date. Defaults to the current date-time
    @jsondata:Name {value: "start_date"}
    string startDate?;
    # This number will be multiplied by the unit amount to compute the subtotal before any discounts or taxes
    int quantity = 1;
    # System-generated unique identifier for an item. Available when the Credit Invoices feature is enabled
    @jsondata:Name {value: "item_id"}
    string itemId?;
    # `true` exempts tax on charges, `false` applies tax on charges. If not defined, then defaults to the Plan and Site settings. This attribute does not work for credits (negative line items). Credits are always applied post-tax. Pre-tax discounts should use the Coupons feature
    @jsondata:Name {value: "tax_exempt"}
    boolean taxExempt?;
    @jsondata:Name {value: "custom_fields"}
    CustomFields customFields?;
    # Determines whether or not tax is included in the unit amount. The Tax Inclusive Pricing feature (separate from the Mixed Tax Pricing feature) must be enabled to use this flag
    @jsondata:Name {value: "tax_inclusive"}
    boolean taxInclusive = false;
    @jsondata:Name {value: "revenue_schedule_type"}
    LineItemRevenueScheduleTypeEnum revenueScheduleType?;
    # Used by Avalara for Communications taxes. The transaction type in combination with the service type describe how the line item is taxed. Refer to [the documentation](https://help.avalara.com/AvaTax_for_Communications/Tax_Calculation/AvaTax_for_Communications_Tax_Engine/Mapping_Resources/TM_00115_AFC_Modules_Corresponding_Transaction_Types) for more available t/s types. If an `Item` is associated to the `LineItem`, then the `avalara_transaction_type` must be absent
    @jsondata:Name {value: "avalara_transaction_type"}
    int avalaraTransactionType?;
    # A positive or negative amount with `type=charge` will result in a positive `unit_amount`.
    # A positive or negative amount with `type=credit` will result in a negative `unit_amount`.
    # If `item_code`/`item_id` is present, `unit_amount` can be passed in, to override the
    # `Item`'s `unit_amount`. If `item_code`/`item_id` is not present then `unit_amount` is required
    @jsondata:Name {value: "unit_amount"}
    float unitAmount;
    @jsondata:Name {value: "credit_reason_code"}
    PartialCreditReasonCodeEnum creditReasonCode?;
    # Accounting Code for the `LineItem`. If `item_code`/`item_id` is part of the request then `accounting_code` must be absent
    @jsondata:Name {value: "accounting_code"}
    string accountingCode?;
    # Optional field used by Avalara, Vertex, and Recurly's In-the-Box tax solution to determine taxation rules. You can pass in specific tax codes using any of these tax integrations. For Recurly's In-the-Box tax offering you can also choose to instead use simple values of `unknown`, `physical`, or `digital` tax codes
    @jsondata:Name {value: "tax_code"}
    string taxCode?;
    @jsondata:Name {value: "origin_tax_address_source"}
    OriginTaxAddressSourceEnum originTaxAddressSource?;
    @jsondata:Name {value: "vertex_transaction_type"}
    VertexTransactionTypeEnum vertexTransactionType?;
    # The Harmonized System (HS) code is an internationally standardized system of names and numbers to classify traded products. The HS code, sometimes called Commodity Code, is used by customs authorities around the world to identify products when assessing duties and taxes. The HS code may also be referred to as the tariff code or customs code. Values should contain only digits and decimals. If `item_code`/`item_id` is part of the request then `harmonized_system_code` must be absent
    @jsondata:Name {value: "harmonized_system_code"}
    string harmonizedSystemCode?;
    @jsondata:Name {value: "destination_tax_address_source"}
    DestinationTaxAddressSourceEnum destinationTaxAddressSource?;
};

# Controls whether credit invoices are automatically applied to new invoices.
# The `mode` field determines the application behavior. When mode is `all`,
# the optional `allowed_origins` array can restrict which credit invoice origins
# are applied
public type CreditApplicationPolicy record {
    # Determines which credit invoices are applied to invoices:
    # - `all`: All available credit invoices are applied (default)
    # - `none`: No credit invoices are applied automatically
    CreditApplicationModeEnum mode;
    # Optional array of credit invoice origin types to allow when mode is `all`.
    # If not specified when mode is `all`, credits from all origins are applied.
    # Only valid when mode is `all`
    @jsondata:Name {value: "allowed_origins"}
    CreditApplicationAllowedOriginTypeEnum[] allowedOrigins?;
};

