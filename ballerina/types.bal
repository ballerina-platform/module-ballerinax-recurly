# Allows you to control how any resulting charges will be calculated and prorated
public type SubscriptionCreateProrationSettings record {
    # Determines how the amount charged is determined for this change
    SubscriptionCreateProrationSettingsChargeEnum charge?;
};

# A discount applied to a line item charge by a coupon redemption
public type LineItemDiscount record {
    # The order in which this discount was applied when multiple coupons were redeemed
    @jsondata:Name {value: "order_applied"}
    int orderApplied?;
    # The ID of the coupon that generated this discount
    @jsondata:Name {value: "coupon_id"}
    string couponId?;
    # The amount discounted on this line item by this coupon redemption
    @jsondata:Name {value: "discount_amount"}
    float discountAmount?;
    # 3-letter ISO 4217 currency code
    @constraint:String {maxLength: 3}
    string currency?;
    # The ID of the coupon redemption that generated this discount
    @jsondata:Name {value: "coupon_redemption_id"}
    string couponRedemptionId?;
    # Will always be `line_item_discount`
    string 'object?;
};

public type BillingInfoCreate record {
    # The bank account number. (ACH, Bacs only)
    @jsondata:Name {value: "account_number"}
    string accountNumber?;
    @jsondata:Name {value: "account_type"}
    AchAccountTypeEnum accountType?;
    # Only supported on Amazon V1. For Amazon V2, use token_id with Recurly.js
    @jsondata:Name {value: "amazon_billing_agreement_id"}
    string amazonBillingAgreementId?;
    @constraint:String {maxLength: 4}
    string year?;
    @jsondata:Name {value: "vat_number"}
    string vatNumber?;
    @jsondata:Name {value: "card_network_preference"}
    CardNetworkEnum cardNetworkPreference?;
    @jsondata:Name {value: "gateway_attributes"}
    BillingInfoCreateGatewayAttributes gatewayAttributes?;
    # The payment method type for a non-credit card based billing info. `bacs`, `becs`, `pix-automatico`, `mercadopago`, `upi-autopay` are the only accepted values
    AchTypeEnum 'type?;
    @jsondata:Name {value: "fraud_session_id"}
    string fraudSessionId?;
    @jsondata:Name {value: "authentication_method"}
    UpiAutopayAuthenticationMethodEnum authenticationMethod?;
    # Credit card number, spaces and dashes are accepted
    string number?;
    @jsondata:Name {value: "paypal_billing_agreement_id"}
    string paypalBillingAgreementId?;
    # A token [generated by Recurly.js](https://recurly.com/developers/reference/recurly-js/#getting-a-token)
    @jsondata:Name {value: "token_id"}
    string tokenId?;
    @jsondata:Name {value: "online_banking_payment_type"}
    OnlineBankingPaymentTypeEnum onlineBankingPaymentType?;
    # The Adyen Risk Profile Reference ID is used to identify the risk profile for the payment method
    @jsondata:Name {value: "adyen_risk_profile_reference_id"}
    string adyenRiskProfileReferenceId?;
    # The `backup_payment_method` field is used to designate a billing info as a backup on the account that will be tried if the initial billing info used for an invoice is declined. All payment methods, including the billing info marked `primary_payment_method` can be set as a backup. An account can have a maximum of 1 backup, if a user sets a different payment method as a backup, the existing backup will no longer be marked as such
    @jsondata:Name {value: "backup_payment_method"}
    boolean backupPaymentMethod?;
    # Specifies a URL to which a consumer will be redirected upon completion of a redirect payment flow. Only redirect payment flows operating through Adyen Components will utilize this return URL
    @jsondata:Name {value: "return_url"}
    string returnUrl?;
    @constraint:String {maxLength: 100}
    string company?;
    # 3-letter ISO 4217 currency code
    string currency?;
    # Array of Payment Gateway References, each a reference to a third-party gateway object of varying types
    @jsondata:Name {value: "payment_gateway_references"}
    record {string token?; PaymentGatewayReferencesEnum reference_type?;} paymentGatewayReferences?;
    @jsondata:Name {value: "first_name"}
    string firstName?;
    @jsondata:Name {value: "roku_billing_agreement_id"}
    string rokuBillingAgreementId?;
    # *STRONGLY RECOMMENDED*
    @constraint:String {maxLength: 4}
    string cvv?;
    Address address?;
    @jsondata:Name {value: "last_name"}
    string lastName?;
    @jsondata:Name {value: "external_hpp_type"}
    ExternalHppTypeEnum externalHppType?;
    # *STRONGLY RECOMMENDED* Customer's IP address when updating their billing information
    @jsondata:Name {value: "ip_address"}
    string ipAddress?;
    @jsondata:Name {value: "transaction_type"}
    GatewayTransactionTypeEnum transactionType?;
    # The bank's rounting number. (ACH only)
    @jsondata:Name {value: "routing_number"}
    string routingNumber?;
    # Bank identifier code for UK based banks. Required for Bacs based billing infos. (Bacs only)
    @jsondata:Name {value: "sort_code"}
    string sortCode?;
    # Tax identifier is required if adding a billing info that is a consumer card in Brazil or in Argentina. This would be the customer's CPF/CNPJ (Brazil) and CUIT (Argentina). CPF, CNPJ and CUIT are tax identifiers for all residents who pay taxes in Brazil and Argentina respectively
    @jsondata:Name {value: "tax_identifier"}
    string taxIdentifier?;
    @jsondata:Name {value: "card_type"}
    CardTypeEnum cardType?;
    # A token generated by Recurly.js after completing a 3-D Secure device fingerprinting or authentication challenge
    @jsondata:Name {value: "three_d_secure_action_result_token_id"}
    string threeDSecureActionResultTokenId?;
    # The `primary_payment_method` field is used to designate the primary billing info on the account. The first billing info created on an account will always become primary. Adding additional billing infos provides the flexibility to mark another billing info as primary, or adding additional non-primary billing infos. This can be accomplished by passing the `primary_payment_method` with a value of `true`. When adding billing infos via the billing_info and /accounts endpoints, this value is not permitted, and will return an error if provided
    @jsondata:Name {value: "primary_payment_method"}
    boolean primaryPaymentMethod?;
    @jsondata:Name {value: "tax_identifier_type"}
    TaxIdentifierTypeEnum taxIdentifierType?;
    # The name associated with the bank account (ACH, SEPA, Bacs only)
    @jsondata:Name {value: "name_on_account"}
    string nameOnAccount?;
    @constraint:String {maxLength: 2}
    string month?;
    @jsondata:Name {value: "gateway_token"}
    string gatewayToken?;
    # The International Bank Account Number, up to 34 alphanumeric characters comprising a country code; two check digits; and a number that includes the domestic bank account number, branch identifier, and potential routing information
    @constraint:String {maxLength: 34}
    string iban?;
    @jsondata:Name {value: "gateway_code"}
    string gatewayCode?;
};

