};

public type InvoiceCreate record {
    # This will default to the Customer Notes text specified on the Invoice Settings for charge invoices. Specify custom notes to add or override Customer Notes on charge invoices
    @jsondata:Name {value: "charge_customer_notes"}
    string chargeCustomerNotes?;
    # The `business_entity_code` is the value that represents a specific business entity for an end customer which will be assigned to the invoice. Available when the `Multiple Business Entities` feature is enabled. If both `business_entity_id` and `business_entity_code` are present, `business_entity_id` will be used
    @jsondata:Name {value: "business_entity_code"}
    string businessEntityCode?;
    @jsondata:Name {value: "net_terms_type"}
    NetTermsTypeEnum netTermsType?;
    # This will default to the Customer Notes text specified on the Invoice Settings for credit invoices. Specify customer notes to add or override Customer Notes on credit invoices
    @jsondata:Name {value: "credit_customer_notes"}
    string creditCustomerNotes?;
    # VAT Reverse Charge Notes only appear if you have EU VAT enabled or are using your own Avalara AvaTax account and the customer is in the EU, has a VAT number, and is in a different country than your own. This will default to the VAT Reverse Charge Notes text specified on the Tax Settings page in your Recurly admin, unless custom notes were created with the original subscription
    @jsondata:Name {value: "vat_reverse_charge_notes"}
    string vatReverseChargeNotes?;
    # This will default to the Terms and Conditions text specified on the Invoice Settings page in your Recurly admin. Specify custom notes to add or override Terms and Conditions
    @jsondata:Name {value: "terms_and_conditions"}
    string termsAndConditions?;
    # For manual invoicing, this identifies the PO number associated with the subscription
    @jsondata:Name {value: "po_number"}
    string poNumber?;
    @jsondata:Name {value: "credit_application_policy"}
    CreditApplicationPolicy creditApplicationPolicy?;
    @jsondata:Name {value: "collection_method"}
    CollectionMethodEnum collectionMethod?;
    # 3-letter ISO 4217 currency code
    @constraint:String {maxLength: 3}
    string currency;
    # Integer paired with `Net Terms Type` and representing the number
    # of days past the current date (for `net` Net Terms Type) or days after
    # the last day of the current month (for `eom` Net Terms Type) that the
    # invoice will become past due. For `manual` collection method, an additional 24 hours is
    # added to ensure the customer has the entire last day to make payment before
    # becoming past due. For example:
    # 
    # If an invoice is due `net 0`, it is due 'On Receipt' and will become past due 24 hours after it's created.
    # If an invoice is due `net 30`, it will become past due at 31 days exactly.
    # If an invoice is due `eom 30`, it will become past due 31 days from the last day of the current month.
    # 
    # For `automatic` collection method, the additional 24 hours is not added. For example, On-Receipt is due immediately, and `net 30` will become due exactly 30 days from invoice generation, at which point Recurly will attempt collection.
    # When `eom` Net Terms Type is passed, the value for `Net Terms` is restricted to `0, 15, 30, 45, 60, or 90`.
    # 
    # For more information on how net terms work with `manual` collection visit our docs page (https://docs.recurly.com/docs/manual-payments#section-collection-terms)
    # or visit (https://docs.recurly.com/docs/automatic-invoicing-terms#section-collection-terms) for information about net terms using `automatic` collection
    @jsondata:Name {value: "net_terms"}
    int netTerms = 0;
    @jsondata:Name {value: "vertex_transaction_type"}
    VertexTransactionTypeEnum vertexTransactionType?;
    # The `business_entity_id` is the value that represents a specific business entity for an end customer which will be assigned to the invoice. Available when the `Multiple Business Entities` feature is enabled. If both `business_entity_id` and `business_entity_code` are present, `business_entity_id` will be used
    @jsondata:Name {value: "business_entity_id"}
    string businessEntityId?;
    # Optionally overrides the suffix component of the composed transaction descriptor. If omitted, the suffix is derived from the subscription's plan name or the invoice description, with a Trial prefix on Visa trial conversions. Subject to gateway availability and payment method support
    @jsondata:Name {value: "transaction_descriptor_suffix"}
    string transactionDescriptorSuffix?;
};

# Parameters to be passed to the `list_unique_coupon_codes` endpoint to obtain the newly generated codes
public type UniqueCouponCodeParams record {
    int 'limit?;
    # The date-time to be included when listing UniqueCouponCodes
    @jsondata:Name {value: "begin_time"}
    string beginTime?;
    string sort?;
    string 'order?;
};

public type FreeTrialUnitEnum "day"|"month"|"week"|"billing_period";

# Details of payments in the lifecycle of a subscription from an external resource that is not managed by the Recurly platform, e.g. App Store or Google Play Store
public type ExternalPaymentPhase record {
    # Allows up to 9 decimal places
    string amount?;
    # When the external subscription was created in Recurly
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # Name of the discount offer given, e.g. "introductory"
    @jsondata:Name {value: "offer_name"}
    string offerName?;
    @jsondata:Name {value: "starting_billing_period_index"}
    int startingBillingPeriodIndex?;
    @jsondata:Name {value: "ending_billing_period_index"}
    int endingBillingPeriodIndex?;
    # When the external subscription was updated in Recurly
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    @jsondata:Name {value: "started_at"}
    string startedAt?;
    # 3-letter ISO 4217 currency code
    @constraint:String {maxLength: 3}
    string currency?;
    # System-generated unique identifier for an external payment phase ID, e.g. `e28zov4fw0v2`
    string id?;
    @jsondata:Name {value: "ends_at"}
    string endsAt?;
    # Billing cycle length
    @jsondata:Name {value: "period_length"}
    string periodLength?;
    # Type of discount offer given, e.g. "FREE_TRIAL"
    @jsondata:Name {value: "offer_type"}
    string offerType?;
    string 'object?;
    # Number of billing periods
    @jsondata:Name {value: "period_count"}
    int periodCount?;
};

# The source of the address that will be used as the destinaion in determining taxes. Available only when the site is on an Elite plan. A value of "destination" refers to the "Customer tax address". A value of "origin" refers to the "Business entity tax address"
public type DestinationTaxAddressSourceEnum "destination"|"origin";

public type Coupon record {
    # The date and time the coupon will expire and can no longer be redeemed. Time is always 11:59:59, the end-of-day Pacific time. Null for bulk coupons configured with a relative redeem-by interval (see redeem_by_interval_unit and redeem_by_interval_amount)
    @jsondata:Name {value: "redeem_by"}
    string redeemBy?;
    # The code the customer enters to redeem the coupon
    string code?;
    # When this number reaches `max_redemptions` the coupon will no longer be redeemable
    @jsondata:Name {value: "unique_coupon_codes_count"}
    int uniqueCouponCodesCount?;
    # Details of the discount a coupon applies. Will contain a `type`
    # property and one of the following properties: `percent`, `fixed`, `trial`
    CouponDiscount discount?;
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # The date and time the coupon was expired early or reached its `max_redemptions`
    @jsondata:Name {value: "expired_at"}
    string expiredAt?;
    @jsondata:Name {value: "redeem_by_interval_unit"}
    CouponRedeemByIntervalUnitEnum redeemByIntervalUnit?;
    CouponDurationEnum duration?;
    # The coupon is valid for one-time, non-plan charges if true
    @jsondata:Name {value: "applies_to_non_plan_charges"}
    boolean appliesToNonPlanCharges = false;
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # Redemptions per account is the number of times a specific account can redeem the coupon. Set redemptions per account to `1` if you want to keep customers from gaming the system and getting more than one discount from the coupon campaign
    @jsondata:Name {value: "max_redemptions_per_account"}
    int maxRedemptionsPerAccount?;
    # Description of the coupon on the invoice
    @jsondata:Name {value: "invoice_description"}
    string invoiceDescription?;
    string id?;
    CouponStateEnum state?;
    # Will be populated when the Coupon being returned is a `UniqueCouponCode`
    @jsondata:Name {value: "unique_coupon_code"}
    UniqueCouponCode uniqueCouponCode?;
    # The coupon is valid for all items if true. If false then `items`
    # will list the applicable items
    @jsondata:Name {value: "applies_to_all_items"}
    boolean appliesToAllItems = false;
    @jsondata:Name {value: "temporal_unit"}
    TemporalUnitEnum temporalUnit?;
    # A maximum number of redemptions for the coupon. The coupon will expire when it hits its maximum redemptions
    @jsondata:Name {value: "max_redemptions"}
    int maxRedemptions?;
    # For a bulk coupon with a relative redeem-by, the number of redeem_by_interval_unit intervals after a code's generation that it remains redeemable. Null unless the coupon uses a relative redeem-by
    @jsondata:Name {value: "redeem_by_interval_amount"}
    int redeemByIntervalAmount?;
    @jsondata:Name {value: "free_trial_unit"}
    FreeTrialUnitEnum freeTrialUnit?;
    # The coupon is valid for all plans if true. If false then `plans` will list the applicable plans
    @jsondata:Name {value: "applies_to_all_plans"}
    boolean appliesToAllPlans = true;
    # This description will show up when a customer redeems a coupon on your Hosted Payment Pages, or if you choose to show the description on your own checkout page
    @jsondata:Name {value: "hosted_page_description"}
    string hostedPageDescription?;
    @jsondata:Name {value: "redemption_resource"}
    RedemptionResourceEnum redemptionResource?;
    # Sets the duration of time the `free_trial_unit` is for
    @jsondata:Name {value: "free_trial_amount"}
    int freeTrialAmount?;
    # On a bulk coupon, the template from which unique coupon codes are generated
    @jsondata:Name {value: "unique_code_template"}
    string uniqueCodeTemplate?;
    # If `duration` is "temporal" than `temporal_amount` is an integer which is multiplied by `temporal_unit` to define the duration that the coupon will be applied to invoices for. When `temporal_unit` is "billing_period", this is the number of complete billing cycles
    @jsondata:Name {value: "temporal_amount"}
    int temporalAmount?;
    # A list of plans for which this coupon applies. This will be `null` if `applies_to_all_plans=true`
    PlanMini[] plans?;
    # The internal name for the coupon
    string name?;
    # A list of items for which this coupon applies. This will be
    # `null` if `applies_to_all_items=true`
    ItemMini[] items?;
    @jsondata:Name {value: "coupon_type"}
    CouponTypeEnum couponType?;
    string 'object?;
};

# Gateway specific attributes associated with this PaymentMethod
public type PaymentMethodGatewayAttributes record {
    # Used by Adyen and Braintree gateways. For Adyen the Shopper Reference value used when the external token was created. For Braintree the PayPal PayerID is populated in the response
    @jsondata:Name {value: "account_reference"}
    string accountReference?;
};

# Merchant-supplied fallback for payment method metadata on the revenue recovery
# endpoint. Recurly's own gateway-token lookup is authoritative for these fields;
# a value supplied here is only used to fill a gap when that lookup is restricted
# or fails, and is overwritten if that lookup later succeeds.
# 
# Not accepted on the Purchase endpoint or the standard billing_info/billing_infos
# endpoints — Recover only
public type RecoveryPaymentMethodCreate record {
    # For a plain card, the card's own first six digits (BIN).
    # 
    # For a tokenized wallet payment (`apple_pay`, `google_pay`, or
    # `google_pay_device_pan`), this is the DPAN's (the wallet/device token's own
    # number) first six digits — **not** the underlying card's (FPAN). The FPAN is
    # never accepted or represented; no separate wallet-specific field is provided
    @jsondata:Name {value: "first_six"}
    string firstSix?;
    # The card's (or, for a tokenized wallet payment, the DPAN's) last four digits. See `first_six` for the DPAN-vs-FPAN distinction on wallets
    @jsondata:Name {value: "last_four"}
    string lastFour?;
    # Expiration month
    @jsondata:Name {value: "exp_month"}
    int expMonth?;
    # Expiration year
    @jsondata:Name {value: "exp_year"}
    int expYear?;
    @jsondata:Name {value: "card_type"}
    CardTypeEnum cardType?;
    RecoveryPaymentMethodEnum 'object?;
};

public type AccountReadOnly record {
    # Indicates if the account has a future subscription
    @jsondata:Name {value: "has_future_subscription"}
    boolean hasFutureSubscription?;
    # Indicates if the account has an active subscription
    @jsondata:Name {value: "has_active_subscription"}
    boolean hasActiveSubscription?;
    # When the account was created
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # The shipping addresses on the account
    @jsondata:Name {value: "shipping_addresses"}
    ShippingAddress[] shippingAddresses?;
    # If present, when the account was last marked inactive
    @jsondata:Name {value: "deleted_at"}
    string deletedAt?;
    # Indicates if the account has a canceled subscription
    @jsondata:Name {value: "has_canceled_subscription"}
    boolean hasCanceledSubscription?;
    # Indicates if the account has a subscription that is either active, canceled, future, or paused
    @jsondata:Name {value: "has_live_subscription"}
    boolean hasLiveSubscription?;
    # Indicates if the account has a paused subscription
    @jsondata:Name {value: "has_paused_subscription"}
    boolean hasPausedSubscription?;
    # When the account was last changed
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # Indicates if the account has a past due invoice
    @jsondata:Name {value: "has_past_due_invoice"}
    boolean hasPastDueInvoice?;
    # The unique token for automatically logging the account in to the hosted management pages. You may automatically log the user into their hosted management pages by directing the user to: `https://{subdomain}.recurly.com/account/{hosted_login_token}`
    @jsondata:Name {value: "hosted_login_token"}
    string hostedLoginToken?;
    @constraint:String {maxLength: 13}
    string id?;
    ActiveStateEnum state?;
    string 'object?;
};

public type ItemUpdate record {
    # Optional, stock keeping unit to link the item to other inventory systems
    @jsondata:Name {value: "external_sku"}
    string externalSku?;
    # Unique code to identify the item
    @constraint:String {maxLength: 50, pattern: re `^[a-z0-9_+-]+$`}
    string code?;
    # The ID of a performance obligation. Performance obligations are
    # only accessible as a part of the Recurly RevRec Standard and
    # Recurly RevRec Advanced features
    @jsondata:Name {value: "performance_obligation_id"}
    string performanceObligationId?;
    # `true` exempts tax on the item, `false` applies tax on the item
    @jsondata:Name {value: "tax_exempt"}
    boolean taxExempt?;
    @jsondata:Name {value: "custom_fields"}
    CustomFields customFields?;
    # Optional, description
    string description?;
    @jsondata:Name {value: "revenue_schedule_type"}
    RevenueScheduleTypeEnum revenueScheduleType?;
    # Used by Avalara for Communications taxes. The transaction type in combination with the service type describe how the item is taxed. Refer to [the documentation](https://help.avalara.com/AvaTax_for_Communications/Tax_Calculation/AvaTax_for_Communications_Tax_Engine/Mapping_Resources/TM_00115_AFC_Modules_Corresponding_Transaction_Types) for more available t/s types
    @jsondata:Name {value: "avalara_transaction_type"}
    int avalaraTransactionType?;
    # Accounting code for invoice line items
    @jsondata:Name {value: "accounting_code"}
    string accountingCode?;
    # Optional field used by Avalara, Vertex, and Recurly's In-the-Box tax solution to determine taxation rules. You can pass in specific tax codes using any of these tax integrations. For Recurly's In-the-Box tax offering you can also choose to instead use simple values of `unknown`, `physical`, or `digital` tax codes
    @jsondata:Name {value: "tax_code"}
    string taxCode?;
    # Used by Avalara for Communications taxes. The transaction type in combination with the service type describe how the item is taxed. Refer to [the documentation](https://help.avalara.com/AvaTax_for_Communications/Tax_Calculation/AvaTax_for_Communications_Tax_Engine/Mapping_Resources/TM_00115_AFC_Modules_Corresponding_Transaction_Types) for more available t/s types
    @jsondata:Name {value: "avalara_service_type"}
    int avalaraServiceType?;
    # This name describes your item and will appear on the invoice when it's purchased on a one time basis
    @constraint:String {maxLength: 255}
    string name?;
    # The Harmonized System (HS) code is an internationally standardized system of names and numbers to classify traded products. The HS code, sometimes called Commodity Code, is used by customs authorities around the world to identify products when assessing duties and taxes. The HS code may also be referred to as the tariff code or customs code. Values should contain only digits and decimals
    @jsondata:Name {value: "harmonized_system_code"}
    string harmonizedSystemCode?;
    # The ID of a general ledger account. General ledger accounts are
    # only accessible as a part of the Recurly RevRec Standard and
    # Recurly RevRec Advanced features
    @jsondata:Name {value: "revenue_gl_account_id"}
    string revenueGlAccountId?;
    # The ID of a general ledger account. General ledger accounts are
    # only accessible as a part of the Recurly RevRec Standard and
    # Recurly RevRec Advanced features
    @jsondata:Name {value: "liability_gl_account_id"}
    string liabilityGlAccountId?;
    Pricing[] currencies?;
};

# Full add-on details
public type AddOnCreate record {
    # Unique code to identify an item. Available when the `Credit Invoices` feature is enabled. If `item_id` and `item_code` are both present, `item_id` will be used
    @jsondata:Name {value: "item_code"}
    string itemCode?;
    # If the tier_type is `flat`, then `tiers` must be absent. The `tiers` object
    # must include one to many tiers with `ending_quantity` and `unit_amount` for
    # the desired `currencies`. There must be one tier without an `ending_quantity` value
    # which represents the final tier
    Tier[] tiers?;
    # The unique identifier for the add-on within its plan. If `item_code`/`item_id` is part of the request then `code` must be absent. If `item_code`/`item_id` is not present `code` is required
    @constraint:String {maxLength: 50}
    string code;
    # The ID of a performance obligation. Performance obligations are
    # only accessible as a part of the Recurly RevRec Standard and
    # Recurly RevRec Advanced features
    @jsondata:Name {value: "performance_obligation_id"}
    string performanceObligationId?;
    # The percentage taken of the monetary amount of usage tracked. This can be up to 4 decimal places. A value between 0.0 and 100.0. Required if `add_on_type` is usage, `tier_type` is `flat` and `usage_type` is percentage. Must be omitted otherwise
    @jsondata:Name {value: "usage_percentage"}
    float usagePercentage?;
    @jsondata:Name {value: "usage_type"}
    UsageTypeCreateEnum usageType?;
    # Used by Avalara for Communications taxes. The transaction type in combination with the service type describe how the add-on is taxed. Refer to [the documentation](https://help.avalara.com/AvaTax_for_Communications/Tax_Calculation/AvaTax_for_Communications_Tax_Engine/Mapping_Resources/TM_00115_AFC_Modules_Corresponding_Transaction_Types) for more available t/s types. If an `Item` is associated to the `AddOn`, then the `avalara_service_type` must be absent
    @jsondata:Name {value: "avalara_service_type"}
    int avalaraServiceType?;
    # Default quantity for the hosted pages
    @jsondata:Name {value: "default_quantity"}
    int defaultQuantity = 1;
    @jsondata:Name {value: "tier_type"}
    TierTypeEnum tierType?;
    # Name of a measured unit to be associated with the add-on. Either `measured_unit_id` or `measured_unit_name` are required when `add_on_type` is `usage`. If `measured_unit_id` and `measured_unit_name` are both present, `measured_unit_id` will be used
    @jsondata:Name {value: "measured_unit_name"}
    string measuredUnitName?;
    # The ID of a general ledger account. General ledger accounts are
    # only accessible as a part of the Recurly RevRec Standard and
    # Recurly RevRec Advanced features
    @jsondata:Name {value: "revenue_gl_account_id"}
    string revenueGlAccountId?;
    # The ID of a general ledger account. General ledger accounts are
    # only accessible as a part of the Recurly RevRec Standard and
    # Recurly RevRec Advanced features
    @jsondata:Name {value: "liability_gl_account_id"}
    string liabilityGlAccountId?;
    @jsondata:Name {value: "add_on_type"}
    AddOnTypeCreateEnum addOnType?;
    # Determines if the quantity field is displayed on the hosted pages for the add-on
    @jsondata:Name {value: "display_quantity"}
    boolean displayQuantity = false;
    # System-generated unique identifier for an item. Available when the `Credit Invoices` feature is enabled. If `item_id` and `item_code` are both present, `item_id` will be used
    @jsondata:Name {value: "item_id"}
    string itemId?;
    @jsondata:Name {value: "usage_calculation_type"}
    UsageCalculationTypeEnum usageCalculationType?;
    @jsondata:Name {value: "revenue_schedule_type"}
    RevenueScheduleTypeEnum revenueScheduleType?;
    # Whether the add-on is optional for the customer to include in their purchase on the hosted payment page. If false, the add-on will be included when a subscription is created through the Recurly UI. However, the add-on will not be included when a subscription is created through the API
    boolean optional?;
    # Used by Avalara for Communications taxes. The transaction type in combination with the service type describe how the add-on is taxed. Refer to [the documentation](https://help.avalara.com/AvaTax_for_Communications/Tax_Calculation/AvaTax_for_Communications_Tax_Engine/Mapping_Resources/TM_00115_AFC_Modules_Corresponding_Transaction_Types) for more available t/s types. If an `Item` is associated to the `AddOn`, then the `avalara_transaction_type` must be absent
    @jsondata:Name {value: "avalara_transaction_type"}
    int avalaraTransactionType?;
    # Array of objects which must have at least one set of tiers
    # per currency and the currency code. The tier_type must be `volume` or `tiered`,
    # if not, it must be absent. There must be one tier without an `ending_amount` value
    # which represents the final tier. This feature is currently in development and
    # requires approval and enablement, please contact support
    @jsondata:Name {value: "percentage_tiers"}
    PercentageTiersByCurrency[] percentageTiers?;
    # Accounting code for invoice line items for this add-on. If no value is provided, it defaults to add-on's code. If `item_code`/`item_id` is part of the request then `accounting_code` must be absent
    @jsondata:Name {value: "accounting_code"}
    string accountingCode?;
    # Optional field used by Avalara, Vertex, and Recurly's In-the-Box tax solution to determine taxation rules. You can pass in specific tax codes using any of these tax integrations. For Recurly's In-the-Box tax offering you can also choose to instead use simple values of `unknown`, `physical`, or `digital` tax codes. If `item_code`/`item_id` is part of the request then `tax_code` must be absent
    @jsondata:Name {value: "tax_code"}
    string taxCode?;
    @jsondata:Name {value: "usage_timeframe"}
    UsageTimeframeCreateEnum usageTimeframe?;
    # System-generated unique identifier for a measured unit to be associated with the add-on. Either `measured_unit_id` or `measured_unit_name` are required when `add_on_type` is `usage`. If `measured_unit_id` and `measured_unit_name` are both present, `measured_unit_id` will be used
    @jsondata:Name {value: "measured_unit_id"}
    string measuredUnitId?;
    # Describes your add-on and will appear in subscribers' invoices. If `item_code`/`item_id` is part of the request then `name` must be absent. If `item_code`/`item_id` is not present `name` is required
    @constraint:String {maxLength: 255}
    string name;
    # The Harmonized System (HS) code is an internationally standardized system of names and numbers to classify traded products. The HS code, sometimes called Commodity Code, is used by customs authorities around the world to identify products when assessing duties and taxes. The HS code may also be referred to as the tariff code or customs code. Values should contain only digits and decimals
    @jsondata:Name {value: "harmonized_system_code"}
    string harmonizedSystemCode?;
    @jsondata:Name {value: "plan_id"}
    string planId?;
    # * If `item_code`/`item_id` is part of the request and the item
    # has a default currency, then `currencies` is optional. If the item does
    # not have a default currency, then `currencies` is required. If `item_code`/`item_id`
    # is not present `currencies` is required.
    # * If the add-on's `tier_type` is `tiered`, `volume`, or `stairstep`,
    # then `currencies` must be absent.
    # * Must be absent if `add_on_type` is `usage` and `usage_type` is `percentage`
    @constraint:Array {minLength: 1}
    AddOnPricing[] currencies?;
};

