public type PaymentMethod record {
    # Credit card number's first six digits.
    # 
    # For a tokenized wallet payment (`apple_pay`, `google_pay`, or
    # `google_pay_device_pan`), this is the DPAN's (the wallet/device token's own
    # number) first six digits, not the underlying card's (FPAN)
    @jsondata:Name {value: "first_six"}
    string firstSix?;
    @jsondata:Name {value: "account_type"}
    AccountTypeEnum accountType?;
    # The bank name of this routing number
    @jsondata:Name {value: "routing_number_bank"}
    string routingNumberBank?;
    # The 2-letter ISO 3166-1 alpha-2 country code associated with the card's issuer, if known
    @jsondata:Name {value: "cc_bin_country"}
    string ccBinCountry?;
    # Expiration month
    @jsondata:Name {value: "exp_month"}
    int expMonth?;
    @jsondata:Name {value: "card_network_preference"}
    CardNetworkEnum cardNetworkPreference?;
    # The IBAN bank account's last two digits
    @jsondata:Name {value: "last_two"}
    string lastTwo?;
    # Expiration year
    @jsondata:Name {value: "exp_year"}
    int expYear?;
    @jsondata:Name {value: "gateway_attributes"}
    PaymentMethodGatewayAttributes gatewayAttributes?;
    @jsondata:Name {value: "card_type"}
    CardTypeEnum cardType?;
    # The bank account's routing number. Only present for ACH payment methods
    @jsondata:Name {value: "routing_number"}
    string routingNumber?;
    # Billing Agreement identifier. Only present for Amazon or Paypal payment methods
    @jsondata:Name {value: "billing_agreement_id"}
    string billingAgreementId?;
    # The name associated with the bank account
    @jsondata:Name {value: "name_on_account"}
    string nameOnAccount?;
    # Credit card number's last four digits. Will refer to bank account if payment
    # method is ACH.
    # 
    # For a tokenized wallet payment (`apple_pay`, `google_pay`, or
    # `google_pay_device_pan`), this is the DPAN's last four digits, not the
    # underlying card's (FPAN)
    @jsondata:Name {value: "last_four"}
    string lastFour?;
    # A token used in place of a credit card in order to perform transactions
    @jsondata:Name {value: "gateway_token"}
    string gatewayToken?;
    @jsondata:Name {value: "funding_source"}
    CardFundingSourceEnum fundingSource?;
    # An identifier for a specific payment gateway
    @jsondata:Name {value: "gateway_code"}
    string gatewayCode?;
    PaymentMethodEnum 'object?;
    # Username of the associated payment method. Currently only associated with Venmo
    string username?;
};

