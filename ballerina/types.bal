# A unique coupon code for a bulk coupon
public type UniqueCouponCode record {
    # The date and time the unique coupon code was redeemed
    @jsondata:Name {value: "redeemed_at"}
    string redeemedAt?;
    # The code the customer enters to redeem the coupon
    string code?;
    # The Coupon ID of the parent Bulk Coupon
    @jsondata:Name {value: "bulk_coupon_id"}
    string bulkCouponId?;
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # Absolute expiry computed and stored at code-generation time. Set only for Window (relative redeem-by) coupons. Null for Anytime coupons and Specific Date coupons — those resolve expiry from the parent coupon's redeem_by at redemption time, not at code-generation time
    @jsondata:Name {value: "redeem_by_date"}
    string redeemByDate?;
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    string id?;
    CouponCodeStateEnum state?;
    # The date and time the coupon was expired early or reached its `max_redemptions`
    @jsondata:Name {value: "expired_at"}
    string expiredAt?;
    # The Coupon code of the parent Bulk Coupon
    @jsondata:Name {value: "bulk_coupon_code"}
    string bulkCouponCode?;
    string 'object?;
};

